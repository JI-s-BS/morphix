# Copy to ~/Morphix/config/morphix.env on the Pi (never commit the real file).
# Keys are read only by the Electron main process and never reach the UI.

# Phase 2
GEMINI_API_KEY=
MESHY_API_KEY=
# Optional Claude CAD generation (also requires OpenSCAD)
ANTHROPIC_API_KEY=
# MORPHIX_GEMINI_MODEL=gemini-3.8-live
# MORPHIX_MESHY_MODEL=meshy-6          # meshy-6-lite = 5 credits/model, meshy-6 = 20
# MORPHIX_MESHY_DAILY_LIMIT=15         # max Meshy jobs per day

# Optional services (local fallbacks always exist)
# Vultr Serverless Inference key (Vultr → Serverless Inference → your subscription → API key):
# backup AI that explains unknown errors when Claude can't. MORPHIX_VULTR_MODEL optional.
VULTR_INFERENCE_API_KEY=
VULTR_API_KEY=
# Tiger Data (TimescaleDB) connection string: Print Guardian history -> guardian_telemetry hypertable
TIGER_DATABASE_URL=
# Swarms (api.swarms.world): multi-agent second opinion on Print Guardian alerts
SWARMS_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Printing (Phase 5) — leave OFF until the operator checklist in docs/PHASE5.md is done with you at the printer
# MORPHIX_PRINT_CONTROLS=1
# MORPHIX_GX_VERIFIED=1           # only after comparing Morphix .gx with an official Afinia .gx
# MORPHIX_PAUSED_STATUSES=PAUSED  # set to the status the QD330 reports while paused (checklist step 5)

# Unverified printer commands, switched on one by one after checking them (docs/PHASE5.md):
# MORPHIX_ALLOW_UNVERIFIED=light,fan,temperatures,motors
# Bed leveling: every print levels the bed (G29 after homing, with the bed hot; docs/PHASE5.md).
# MORPHIX_LEVEL_GCODE=G29                    # the command; replace it with the one an official Afinia .gx uses
# MORPHIX_LEVELING=printer                   # turn it off and leave leveling to the QD330's own setting

# Web portal (Auth0) — see docs/PORTAL.md for the Auth0 dashboard steps
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# PORTAL_BASE_URL=http://192.168.86.38:8443
# PORTAL_SESSION_SECRET=           # any long random string (e.g. from: openssl rand -hex 32)
# AUTH0_ALLOWED_EMAILS=you@example.com
# AUTH0_ADMIN_EMAILS=you@example.com   # may use printer controls from the portal
# PORTAL_PORT=8443

# Morphix Remote (Vercel phone UI + outbound Cloudflare Tunnel)
# The API listens only on loopback; cloudflared connects to it outbound.
# MORPHIX_REMOTE=1
# MORPHIX_REMOTE_HOST=127.0.0.1
# MORPHIX_REMOTE_PORT=8787
# Exact Vercel origins, comma-separated. No wildcards.
# MORPHIX_REMOTE_ORIGINS=https://your-morphix-remote.vercel.app
# The same Vercel URL is encoded into the one-time QR shown on the Pi.
# MORPHIX_REMOTE_SITE_URL=https://your-morphix-remote.vercel.app
# Optional "Sign in with Auth0" on the phone's Connect page (docs/REMOTE.md section 5).
# Client ID of a separate Auth0 Single Page Application (not the portal's AUTH0_CLIENT_ID).
# Uses AUTH0_DOMAIN above; only AUTH0_ALLOWED_EMAILS / AUTH0_ADMIN_EMAILS may connect (empty = nobody).
# MORPHIX_REMOTE_AUTH0_CLIENT_ID=

# Printer (defaults shown)
# MORPHIX_PRINTER_HOST=192.168.10.51
# MORPHIX_PRINTER_POLL_SECONDS=5
