# Optional legacy key file. Most people never need it: add API keys on the setup page
# (Settings → System setup), which stores them in the data dir with mode 0600.
#
# If you do use it: copy it to <data dir>/config/morphix.env (default data dir:
# ~/.local/share/morphix, or /var/lib/morphix for the system service; ~/Morphix for the original
# Pi kiosk) and restart Morphix. Values here are read at start-up; real environment variables win.
# Never commit the real file.

# AI keys (all optional)
GEMINI_API_KEY=
MESHY_API_KEY=
# ANTHROPIC_API_KEY: Claude CAD generation (also needs OpenSCAD)
ANTHROPIC_API_KEY=
THINGIVERSE_TOKEN=
# MORPHIX_GEMINI_MODEL=gemini-3.8-live
# MORPHIX_MESHY_MODEL=meshy-6          # meshy-6-lite = 5 credits/model, meshy-6 = 20
# MORPHIX_MESHY_DAILY_LIMIT=15         # max Meshy jobs per day

# ---- Afinia QD330 built-in path (only when no printer is set up on the setup page) ----
# MORPHIX_PRINTER_HOST=192.168.10.51
# MORPHIX_PRINTER_POLL_SECONDS=5
# Printing stays OFF until the operator checklist in docs/SAFETY.md is done with you at the printer:
# MORPHIX_PRINT_CONTROLS=1
# MORPHIX_GX_VERIFIED=1           # only after comparing Morphix .gx with an official Afinia .gx (docs/QD330.md)
# MORPHIX_PAUSED_STATUSES=PAUSED  # the status the QD330 reports while paused (checklist step 5)
# Unverified printer commands, switched on one by one after checking them (docs/SAFETY.md):
# MORPHIX_ALLOW_UNVERIFIED=light,fan,temperatures,motors
# Bed leveling: every print levels the bed (G29 after homing, with the bed hot; docs/QD330.md#bed-leveling).
# MORPHIX_LEVEL_GCODE=G29         # the command; replace it with the one an official Afinia .gx uses
# MORPHIX_LEVELING=printer        # leave leveling to the QD330's own setting
